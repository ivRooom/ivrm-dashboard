# Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server IDと32文字以上のAgent SecretをJSONで定義する。
# Vercelの暗号化済みEnvironment Variablesへ保存し、公開リポジトリへ実値をコミットしない。
IVRM_AGENT_SECRETS_JSON={"oci-minecraft-01":"replace-with-a-long-random-secret-at-least-32-characters"}

# Discord OAuth2 + Guild Role認証
# Productionではadmin.ivrm.jp / member.ivrm.jpの既存Discord ApplicationとSecretを共有せず、
# console.ivrm.jp専用Discord Applicationを推奨する。短期検証で既存Applicationを共有する場合も、
# Discord Developer Portalへconsole専用Callbackを追加し、恒久運用ではSecret境界を分離する。
# disabled: 従来認証のみ / report: Discordログインを検証 / enforce: Discord Session必須
# PRマージ直後はdisabledを維持し、実IDとSecret設定後にreportへ切り替える。
IVRM_DISCORD_AUTH_MODE=disabled
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=replace-with-discord-client-secret
DISCORD_GUILD_ID=223456789012345678
DISCORD_REDIRECT_URI=https://console.ivrm.jp/api/auth/discord/callback

# Discord Role IDをWebコンソールRoleへ対応付ける。
# 同じRole IDを複数のConsole Roleへ重複指定しない。
IVRM_DISCORD_ROLE_MAP_JSON={"viewer":["323456789012345678"],"operator":[],"administrator":[],"owner":[]}

# 300〜86400秒。Role変更を反映するにはSession期限後に再ログインする。
IVRM_DISCORD_SESSION_TTL_SECONDS=14400
