IVRM_AGENT_SERVER_ID=oci-minecraft-01
IVRM_AGENT_ENDPOINT=https://console.ivrm.jp/api/agent/heartbeat
# 予備 ingest (ingest-relay, #242)。主系が失敗したときだけ使う。tailnet 宛先は HTTP 可。
# IVRM_AGENT_FALLBACK_ENDPOINT=http://ivrm-db-postgres-01.<tailnet>.ts.net:3939/api/agent/heartbeat
# IVRM_AGENT_BACKUP_FALLBACK_ENDPOINT=http://ivrm-db-postgres-01.<tailnet>.ts.net:3939/api/agent/backups
# IVRM_AGENT_LOG_FALLBACK_ENDPOINT=http://ivrm-db-postgres-01.<tailnet>.ts.net:3939/api/agent/logs
IVRM_AGENT_BACKUP_ENDPOINT=https://console.ivrm.jp/api/agent/backups
IVRM_AGENT_LOG_ENDPOINT=https://console.ivrm.jp/api/agent/logs
IVRM_AGENT_TOKEN=replace-with-a-long-random-secret
IVRM_AGENT_INTERVAL=60s
IVRM_AGENT_DOCKER_SNAPSHOT_PATH=/run/ivrm-agent/docker-state.json
