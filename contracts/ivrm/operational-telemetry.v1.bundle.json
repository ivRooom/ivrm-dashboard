                "events"
              ],
              "x-ivrm-body-max-bytes": 65536,
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "batchId": {
                  "type": "string",
                  "format": "uuid"
                },
                "producerId": {
                  "$ref": "#/$defs/identifier",
                  "x-ivrm-authenticated-subject": {
                    "header": "X-IVRM-Producer-ID",
