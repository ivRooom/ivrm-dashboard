              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted",
                  "code"
                ],
                "properties": {
                  "accepted": {
                    "const": false
                  },
                  "code": {
                    "type": "string",
                    "enum": [
