      "responses": {
        "200": {
          "description": "Identical batch replay; original receipt with replayed=true",
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://ivrm.jp/contracts/operations/telemetry/v1/response.schema.json",
                "title": "Operational Telemetry Receipt v1",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted",
                  "batchId",
                  "replayed",
                  "acceptedEvents",
                  "duplicateEvents"
                ],
                "properties": {
                  "accepted": {
                    "const": true
                  },
                  "batchId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "replayed": {
                    "type": "boolean"
                  },
                  "acceptedEvents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "duplicateEvents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "description": "202 for a new durable transaction, 200 for an identical batch replay. acceptedEvents + duplicateEvents equals request event count; the replay returns the original receipt with replayed=true. Partial acceptance is forbidden. ACK proves durable ingest, not AWS archival."
              }
            }
          }
        },
        "202": {
          "description": "New durable batch; replayed=false",
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "$id": "https://ivrm.jp/contracts/operations/telemetry/v1/response.schema.json",
                "title": "Operational Telemetry Receipt v1",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted",
                  "batchId",
                  "replayed",
                  "acceptedEvents",
                  "duplicateEvents"
