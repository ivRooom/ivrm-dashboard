                  "replayed": {
                    "type": "boolean"
                  },
                  "acceptedEvents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "duplicateEvents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
