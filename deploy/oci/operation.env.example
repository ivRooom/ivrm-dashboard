# Safe default: staging these units must never claim or execute lifecycle jobs.
IVRM_OPERATION_EXECUTION_ENABLED=false
IVRM_OPERATION_CLAIM_ENDPOINT=https://console.ivrm.jp/api/agent/operations/claim
IVRM_OPERATION_TRANSITION_ENDPOINT=https://console.ivrm.jp/api/agent/operations/transition
IVRM_OPERATION_LEASE_OWNER=oci-minecraft-01:operation-worker
IVRM_OPERATION_WORK_DIR=/run/ivrm-agent/operations
IVRM_OPERATION_POLL_INTERVAL=5s
# Must remain below the 300s DB lease. The fixed helper is bounded to <= ~210s.
IVRM_OPERATION_RESULT_TIMEOUT=225s
