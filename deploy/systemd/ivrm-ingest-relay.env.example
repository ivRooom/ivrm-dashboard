# ivrm-ingest-relay の環境変数例。実ファイルは /etc/ivrm-ingest-relay/relay.env (root:ivrm-relay 0640)。
# 待ち受けは必ず DB ホストの tailnet IP を指定する (公開インターフェースでは待ち受けない)。
IVRM_RELAY_BIND=100.x.y.z:3939
# serverId -> secret の JSON。値は Vercel 側 IVRM_AGENT_SECRETS_JSON (base + additional を統合し重複なし) と同一にする。
IVRM_RELAY_SECRETS_FILE=/etc/ivrm-ingest-relay/agent-secrets.json
# PostgREST (ivrm_dashboard) のベース URL と service role key。本系 Web と同じ宛先を使う。
IVRM_RELAY_POSTGREST_URL=https://api.ivrm.jp/dash/rest/v1
IVRM_RELAY_SERVICE_KEY=<service role key>
