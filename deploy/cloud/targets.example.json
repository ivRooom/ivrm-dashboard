{
  "collectorServerId": "aws-app-01",
  "allowedHttpHosts": [
    "console.ivrm.jp",
    "herta.ivrm.jp"
  ],
  "targets": [
    {
      "id": "aws-app",
      "provider": "aws",
      "region": "ap-northeast-1",
      "resource": "REPLACE_WITH_AWS_RESOURCE_ID"
    },
    {
      "id": "lightsail-herta",
      "provider": "lightsail",
      "region": "ap-northeast-1",
      "resource": "REPLACE_WITH_LIGHTSAIL_RESOURCE_ID"
    },
    {
      "id": "oci-minecraft",
      "provider": "oci",
      "region": "ap-tokyo-1",
      "resource": "REPLACE_WITH_OCI_RESOURCE_ID"
    },
    {
      "id": "vercel-console",
      "provider": "vercel",
      "resource": "REPLACE_WITH_VERCEL_RESOURCE_ID",
      "teamId": "REPLACE_WITH_TEAM_ID",
      "productionAlias": "console.ivrm.jp"
    },
    {
      "id": "cloudflare-console-dns",
      "provider": "cloudflare",
      "kind": "dns",
      "resource": "REPLACE_WITH_CLOUDFLARE_RESOURCE_ID",
      "name": "console.ivrm.jp",
      "recordType": "CNAME",
      "expectedContent": "REPLACE_WITH_EXPECTED_DNS_TARGET",
      "expectedProxied": true
    },
    {
      "id": "cloudflare-runtime-tunnel",
      "provider": "cloudflare",
      "kind": "tunnel",
      "resource": "REPLACE_WITH_CLOUDFLARE_RESOURCE_ID",
      "accountId": "REPLACE_WITH_ACCOUNT_ID"
    },
    {
      "id": "http-console",
      "provider": "http",
      "url": "https://console.ivrm.jp/api/health"
    },
    {
      "id": "http-herta",
      "provider": "http",
      "url": "https://herta.ivrm.jp/"
    }
  ]
}
