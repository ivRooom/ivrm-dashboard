# Non-interactive, read-only provider credentials. Never use the operations profile.
IVRM_CLOUD_VERCEL_TOKEN=
IVRM_CLOUD_NETLIFY_TOKEN=
IVRM_CLOUD_CLOUDFLARE_TOKEN=
# On OCI, use a read-only instance principal; on AWS use its instance role.
IVRM_CLOUD_OCI_AUTH=instance_principal
# If running away from OCI, set api_key and an absolute path readable by ivrm-agent:
# IVRM_CLOUD_OCI_AUTH=api_key
# OCI_CONFIG_FILE=/etc/ivrm-agent/oci/config
# OCI_CONFIG_PROFILE=IVROOOM_MCP_READONLY
# Do not put AWS SSO or an administrator profile in this service.
