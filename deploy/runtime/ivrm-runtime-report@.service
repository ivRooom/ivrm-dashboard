[Unit]
Description=IVRM signed runtime inventory report (%i)
Requires=ivrm-runtime-snapshot@%i.service
After=ivrm-runtime-snapshot@%i.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ivrm-agent
Group=ivrm-agent
EnvironmentFile=/etc/ivrm-agent/agent.env
ExecStart=/usr/bin/python3 /opt/ivrm-runtime-collector/report.py
TimeoutStartSec=30
MemoryMax=64M
CPUQuota=10%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
