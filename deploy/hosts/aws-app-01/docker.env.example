# aws-app-01 (EC2 / IVRM App) — Docker snapshot allowlist for ivrm-agent.
# Install as /etc/ivrm-agent/docker.env (root:root 600) together with the
# snapshot units from deploy/oci/. The agent itself is already installed and
# heartbeating on this host; it only lacks the snapshot path
# (IVRM_AGENT_DOCKER_SNAPSHOT_PATH in agent.env + this file).
# Container list verified live on 2026-11-11 (13 running). Heartbeat payload
# limit is 20 containers (apps/web/lib/heartbeat.ts MAX_CONTAINERS).
IVRM_DOCKER_CONTAINERS=ivrm-admin,ivrm-ai,ivrm-api,ivrm-cloudflared,ivrm-contact,ivrm-dispatch-worker,ivrm-home,ivrm-member,ivrm-postgrest,ivrm-release-registry,ivrm-runtime-caddy,ivrm-runtime-health,release-web-1
IVRM_DOCKER_SNAPSHOT_PATH=/run/ivrm-agent/docker-state.json
IVRM_DOCKER_BINARY=/usr/bin/docker
IVRM_MINECRAFT_PROBE_ENABLED=false
IVRM_MINECRAFT_PERFORMANCE_ENABLED=false
