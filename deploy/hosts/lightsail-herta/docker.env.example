# lightsail-herta (Lightsail / Herta) — Docker snapshot allowlist for ivrm-agent.
# Install as /etc/ivrm-agent/docker.env (root:root 600) together with the
# snapshot units from deploy/oci/.
# Container list verified live on 2026-11-11: 7 running + herta-migrator-1
# (oneshot, normally exited — its expectation is 'on-demand', see
# deploy/sql/register-monitoring-expansion.sql).
IVRM_DOCKER_CONTAINERS=herta-api-1,herta-bot-1,herta-caddy-1,herta-migrator-1,herta-nginx-1,herta-redis-1,herta-studio-1,herta-worker-1
IVRM_DOCKER_SNAPSHOT_PATH=/run/ivrm-agent/docker-state.json
IVRM_DOCKER_BINARY=/usr/bin/docker
IVRM_MINECRAFT_PROBE_ENABLED=false
IVRM_MINECRAFT_PERFORMANCE_ENABLED=false
