# lightsail-herta — ivrm-agent environment.
# Install as /etc/ivrm-agent/agent.env (root:ivrm-agent 640).
# IVRM_AGENT_TOKEN is the per-host secret: generate a fresh random value,
# store it here, and register the same value in the console's
# IVRM_AGENT_SECRETS_JSON (Vercel env) under the key "lightsail-herta"
# before starting the agent. Never commit the real value.
IVRM_AGENT_SERVER_ID=lightsail-herta
IVRM_AGENT_ENDPOINT=https://console.ivrm.jp/api/agent/heartbeat
IVRM_AGENT_TOKEN=<set-at-install-time>
IVRM_AGENT_INTERVAL=15s
IVRM_AGENT_DOCKER_SNAPSHOT_PATH=/run/ivrm-agent/docker-state.json
